#
# example.env — annotated reference for every environment variable read
# by the openccu-loom daemon.
#
# Usage: reference this file via `env_file:` in config.yaml, or source it
# before starting the process.  Environment values take precedence over
# YAML settings; secrets are best kept here rather than in the YAML or DB.
#
# Format: KEY=VALUE, one per line.  All values below are placeholders —
# do not use real credentials.


# ---------------------------------------------------------------------------
# Overlay / common knobs  (internal/config/overlay.go OverlayFromEnv)
# ---------------------------------------------------------------------------
# These variables map onto the matching YAML fields.  Set only the ones you
# need to override; unset variables leave the YAML value intact.

# UI locale, e.g. "en" or "de".
#OPENCCU_LOOM_LOCALE=en

# Directory for persistent data (SQLite database, key file, …).
#OPENCCU_LOOM_DATA_DIR=/var/lib/openccu-loom

# Log verbosity: debug | info | warn | error
#OPENCCU_LOOM_LOG_LEVEL=info

# Log output format: text | json
#OPENCCU_LOOM_LOG_FORMAT=json

# Hostname / IP that the CCU will use to reach the callback servers.
# Must be reachable from the CCU network; defaults to the auto-detected
# outbound address when left unset.
#OPENCCU_LOOM_CALLBACK_HOST=192.0.2.10

# TCP port for the XML-RPC callback server (HTTP).  0 = OS-assigned.
#OPENCCU_LOOM_CALLBACK_PORT=8120

# TCP port for the BIN-RPC callback server (raw TCP, CUxD).  0 = OS-assigned.
#OPENCCU_LOOM_CALLBACK_BIN_PORT=8129

# Listen address for the REST / WebSocket API, e.g. ":8119" or "127.0.0.1:8119".
#OPENCCU_LOOM_REST_LISTEN=:8119

# Enable OpenAPI request/response validation on the REST server.
# Accepted values: 1 / true / yes / on  or  0 / false / no / off
#OPENCCU_LOOM_REST_OPENAPI_VALIDATE=false

# Path to an external openapi.yaml spec file.  Overrides the embedded copy.
#OPENCCU_LOOM_REST_OPENAPI_SPEC_PATH=/etc/openccu-loom/openapi.yaml

# MQTT broker URL (overrides north.mqtt.broker_url).
#OPENCCU_LOOM_MQTT_BROKER_URL=tcp://mqtt.example:1883


# ---------------------------------------------------------------------------
# Secrets  (at-rest encryption, ADR 0027)
# ---------------------------------------------------------------------------
# Keeping secrets here avoids storing them in config.yaml or the database.
#
# Note: per-CCU / per-central passwords are set via `password:` in
# config.yaml (one per central section) and are encrypted at rest in the
# database.  There is no single env-var slot for them; use the YAML field
# for each central, or the DB encryption below to protect them at rest.

# Base64-encoded 32-byte AES-256 master key for DB secret encryption.
# When not set, openccu-loom auto-generates and persists a key file at
# <data_dir>/secret.key (created with mode 0600 on first start).
# Setting this variable is recommended for container / cloud deployments
# where the data directory is ephemeral.
#
# Generate a fresh key:
#   openssl rand -base64 32
#
#OPENCCU_LOOM_SECRET_KEY=replace_with_output_of_openssl_rand_base64_32

# MQTT broker password.  Overrides whatever is stored in the DB at runtime;
# the value is never written back to the database.
#OPENCCU_LOOM_MQTT_PASSWORD=changeme

# OIDC client secret.  Overrides the value stored in the DB at runtime.
#OPENCCU_LOOM_OIDC_CLIENT_SECRET=changeme


# ---------------------------------------------------------------------------
# Deployment / debug flags
# ---------------------------------------------------------------------------
# These flags are off by default.  Uncomment only when needed.

# Tell the daemon it is running under a supervisor (systemd / s6 / …).
# When set to "1" the daemon suppresses the PID-file and double-fork logic
# and instead writes structured log lines suited for journal capture.
# JOURNAL_STREAM (set by systemd) is detected automatically when present;
# KUBERNETES_SERVICE_HOST (set by the kubelet) is also auto-detected.
# Use this flag for other supervisors or to force supervisor mode explicitly.
#OPENCCU_LOOM_SUPERVISOR=1

# Dump raw Matter subscribe request/response payloads to disk for debugging.
# Set to any non-empty value to enable; files are written under <data_dir>.
#OPENCCU_LOOM_MATTER_DUMP_SUBSCRIBE=1
