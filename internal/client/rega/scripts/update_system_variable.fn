!# openccu-loom — update_system_variable
!# Params: ##name##  (target sysvar name)
!#         ##unit##  (optional unit string; "" leaves untouched)
!#         ##min##   / ##max## (FLOAT/INTEGER bounds; "" untouched)
!#         ##values## (semicolon-separated ENUM keys; "" untouched)
!#         ##description## (optional description text; "" untouched)
!# Output: "ok" once the metadata patch landed, "" otherwise.
!#
!# Updates an existing sysvar's metadata in place. Type changes are
!# unsafe at the CCU level — callers wanting to change the type
!# should delete (JSON-RPC `SysVar.deleteSysVarByName`) and recreate
!# (JSON-RPC `SysVar.createBool/createFloat/createEnum` or the
!# create_system_variable Rega script for INTEGER/STRING/Unit).

string sName = "##name##";
string sUnit = "##unit##";
string sMin = "##min##";
string sMax = "##max##";
string sValues = "##values##";
string sDescription = "##description##";

object oSv = dom.GetObject(ID_SYSTEM_VARIABLES).Get(sName);
if (oSv) {
    if (sUnit != "") { oSv.ValueUnit(sUnit); }
    if (sMin != "") { oSv.ValueMin(sMin); }
    if (sMax != "") { oSv.ValueMax(sMax); }
    if (sValues != "") { oSv.ValueList(sValues); }
    if (sDescription != "") { oSv.DPInfo(sDescription); }
    Write("ok");
}
