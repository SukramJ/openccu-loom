!# openccu-loom — update_system_variable
!# Params: ##name##  (target sysvar name)
!#         ##newname## (optional new name; "" leaves the name unchanged)
!#         ##unit##  (optional unit string; "" leaves untouched)
!#         ##min##   / ##max## (FLOAT/INTEGER bounds; "" untouched)
!#         ##values## (semicolon-separated ENUM keys; "" untouched)
!#         ##description## (optional description text; "" untouched)
!#         ##valuename0## / ##valuename1## (BOOL/ALARM false/true labels; "" untouched)
!#         ##visible## / ##logged## ("true"/"false" set the WebUI-visibility and
!#           archive (DPArchive) flags; "" leaves each flag untouched)
!#         ##channel## (channel ise id for the "Kanalzuordnung"; "" leaves the
!#           assignment untouched, "-1" clears it, a positive id assigns it)
!# Output: "ok" once the metadata patch landed, "" otherwise.
!#
!# Updates an existing sysvar's metadata in place. A non-empty newname
!# renames the variable (mirrors the CCU WebUI's ::changeName via
!# rega/esp/system.fn). Type changes are unsafe at the CCU level —
!# callers wanting to change the type should delete (JSON-RPC
!# `SysVar.deleteSysVarByName`) and recreate (JSON-RPC
!# `SysVar.createBool/createFloat/createEnum` or the
!# create_system_variable Rega script for INTEGER/STRING/Unit).

string sName = "##name##";
string sNewName = "##newname##";
string sUnit = "##unit##";
string sMin = "##min##";
string sMax = "##max##";
string sValues = "##values##";
string sDescription = "##description##";
string sValueName0 = "##valuename0##";
string sValueName1 = "##valuename1##";
string sVisible = "##visible##";
string sLogged = "##logged##";
string sChannel = "##channel##";

object oSv = dom.GetObject(ID_SYSTEM_VARIABLES).Get(sName);
if (oSv) {
    if (sUnit != "") { oSv.ValueUnit(sUnit); }
    if (sMin != "") { oSv.ValueMin(sMin); }
    if (sMax != "") { oSv.ValueMax(sMax); }
    if (sValues != "") { oSv.ValueList(sValues); }
    if (sDescription != "") { oSv.DPInfo(sDescription); }
    if (sValueName0 != "") { oSv.ValueName0(sValueName0); }
    if (sValueName1 != "") { oSv.ValueName1(sValueName1); }
    if (sVisible == "true") { oSv.Visible(true); }
    if (sVisible == "false") { oSv.Visible(false); }
    if (sLogged == "true") { oSv.DPArchive(true); }
    if (sLogged == "false") { oSv.DPArchive(false); }
    if (sChannel != "") { oSv.Channel(sChannel.ToInteger()); }
    if (sNewName != "") { oSv.Name(sNewName); }
    Write("ok");
}
