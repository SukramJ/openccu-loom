!# openccu-loom — fetch_all_device_data
!# Params: ##interface## (interface id, e.g. "HmIP-RF")
!# Output: {"<DP.Name-uri-encoded>": <value>, ...}
!#
!# Returns every data point of the given interface that has a valid
!# timestamp. The JSON keys are the CCU's dot-separated DP names
!# (e.g. "HmIP-RF.0001ABCD:1.LEVEL"), URL-encoded; values are either
!# bare `true`/`false`, a bare number, or a double-quoted string
!# depending on the ValueType. Based on iobroker.hm-rega datapoints.fn
!# (hobbyquaker, MIT) and aiohomematic's fetch_all_device_data.fn.

string sUse_Interface = "##interface##";
string sDevId;
string sChnId;
string sDPId;
var vDPValue;
boolean bDPFirst = true;
object oInterface = interfaces.Get(sUse_Interface);

Write('{');
if (oInterface) {
    integer iInterface_ID = interfaces.Get(sUse_Interface).ID();
    string sAllDevices = dom.GetObject(ID_DEVICES).EnumUsedIDs();
    foreach (sDevId, sAllDevices) {
        object oDevice = dom.GetObject(sDevId);
        if ((oDevice) && (oDevice.ReadyConfig()) && (oDevice.Interface() == iInterface_ID)) {
            foreach (sChnId, oDevice.Channels()) {
                object oChannel = dom.GetObject(sChnId);
                if (oChannel) {
                    var oDPs = oChannel.DPs();
                    if (oDPs) {
                        foreach(sDPId, oDPs.EnumUsedIDs()) {
                            object oDP = dom.GetObject(sDPId);
                            if (oDP && oDP.Timestamp()) {
                                if (oDP.TypeName() != "VARDP") {
                                    integer sValueType = oDP.ValueType();
                                    boolean bHasValue = false;
                                    string sValue;
                                    string sID = oDP.Name().UriEncode();
                                    if (sValueType == 20) {
                                        sValue = oDP.Value().UriEncode();
                                        bHasValue = true;
                                    } else {
                                        vDPValue = oDP.Value();
                                        if (sValueType == 2) {
                                            if (vDPValue) {
                                                sValue = "true";
                                            } else {
                                                sValue = "false";
                                            }
                                            bHasValue = true;
                                        } else {
                                            !# Empty value = not measured yet (e.g. ACTUAL_TEMPERATURE right
                                            !# after a CCU restart). Skip the data point instead of coercing
                                            !# to "0": emitting 0 wrote an implausible placeholder into the
                                            !# cache that consumers could not tell apart from a real reading.
                                            !# Leaving it out yields a cache miss, so the value stays unset
                                            !# until a real measurement arrives.
                                            if (vDPValue == "") {
                                                bHasValue = false;
                                            } else {
                                                sValue = vDPValue;
                                                bHasValue = true;
                                            }
                                        }
                                    }
                                    if (bHasValue) {
                                        if (bDPFirst) {
                                            bDPFirst = false;
                                        } else {
                                            WriteLine(',');
                                        }
                                        Write('"');
                                        Write(sID);
                                        Write('":');
                                        if (sValueType == 20) {
                                            Write('"');
                                            Write(sValue);
                                            Write('"');
                                        } else {
                                            Write(sValue);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
Write('}');
