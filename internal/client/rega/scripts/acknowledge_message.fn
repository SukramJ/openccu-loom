!# openccu-loom — acknowledge_message
!# Params: ##message_id##
!# Output: {"success":<bool>,"error":"<reason>"}
!#
!# Acknowledges a service message (ID_SERVICES) or alarm message
!# (ID_SYSTEM_VARIABLES). Service messages require the trigger
!# datapoint to have the OPERATION_WRITE bit set; alarm messages
!# are acknowledged unconditionally.
!#
!# The trigger guard is resolved into bWritable before the branch
!# rather than written as `oTrigger && (...)`. The combined form was
!# reported not to
!# work as written on a CCU test system for the sibling
!# get_alarm_messages.fn, and the branch here needs an else. A missing
!# trigger keeps bWritable false and therefore still reports the
!# not-acknowledgeable error.
!#
!# Invariant: exactly one of (success:true) or (success:false + error)
!# is produced.

string sMessageId = "##message_id##";
string sCandidate;
object oTrigger; object oServices;
boolean bIsService = false;
boolean bWritable = false;
boolean bSuccess = false;
string sError = "";

object oAlarm = dom.GetObject(sMessageId);
if (oAlarm) {
    oServices = dom.GetObject(ID_SERVICES);
    if (oServices) {
        foreach (sCandidate, oServices.EnumIDs()) {
            if (sCandidate == sMessageId) {
                bIsService = true;
            }
        }
    }

    if (bIsService) {
        oTrigger = dom.GetObject(oAlarm.AlTriggerDP());
        if (oTrigger) {
            if (oTrigger.Operations() & 2) {
                bWritable = true;
            }
        }

        if (bWritable) {
            oAlarm.AlReceipt();
            bSuccess = true;
        } else {
            sError = "Message is not acknowledgeable";
        }
    } else {
        oAlarm.AlReceipt();
        bSuccess = true;
    }
} else {
    sError = "Message not found";
}

Write('{"success":');
if (bSuccess) {
    Write('true');
} else {
    Write('false');
}
Write(',"error":"' # sError # '"}');
