!# openccu-loom — get_serial
!# Output: {"serial":"<board serial verbatim, or 'unknown'>"}
!#
!# Tries three filesystem locations in order and emits whichever yields a
!# non-empty value, untouched. The reduction to the daemon's canonical
!# form happens in the Go caller (rega.Runner.GetSerial), not here.

string sSerial = "";
string sErr = "";

system.Exec("/bin/sh -c 'cat /var/board_sgtin'", &sSerial, &sErr);
if (sSerial) { sSerial = sSerial.Trim(); }

if (!sSerial) {
    system.Exec("/bin/sh -c 'cat /var/board_serial'", &sSerial, &sErr);
    if (sSerial) { sSerial = sSerial.Trim(); }
}

if (!sSerial) {
    system.Exec("/bin/sh -c 'cat /sys/module/plat_eq3ccu2/parameters/board_serial'", &sSerial, &sErr);
    if (sSerial) { sSerial = sSerial.Trim(); }
}

if (!sSerial) {
    sSerial = "unknown";
}

Write('{"serial":"' # sSerial # '"}');
