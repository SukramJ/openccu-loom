!# openccu-loom — get_service_messages
!# Output: array of service-message records
!#
!# Walks ID_SERVICES; for each alarm with AlState == 1 emits a record
!# with id, name, timestamp, type, address, device_name,
!# last_timestamp, counter, rooms, functions, quittable.
!#
!# quittable is true iff the alarm's trigger datapoint has the
!# OPERATION_WRITE bit set (bit 2 in .Operations()).
!#
!# rooms and functions are JSON arrays. They used to be one string with
!# the entries joined by a raw tab, which is a control character and
!# therefore illegal inside a JSON string: a single channel carrying two
!# functions made the whole document unparsable, so the daemon received
!# no service messages at all rather than one incomplete record.
!#
!# Timestamps are Unix seconds via the *Seconds() accessors, matching
!# get_alarm_messages. timestamp is when the message first appeared,
!# last_timestamp when it last recurred — 0 when it never did.
!#
!# The object guard is a separate, nested if rather than
!# `oAlarm && (...)`. The combined form was reported not to work as
!# written on a CCU test system for the sibling get_alarm_messages.fn;
!# the same shape is avoided here, without that report having been
!# reproduced for this script.
!#
!# Inbox/onboarding devices are not included here — the coordinator
!# uses get_inbox_devices for that flow (post-MVP).

string sAlarmId; string sRawName; string sName; string sAddress; string sRest;
string sDeviceName; string sRooms; string sFunctions; string sRoomId; string sFuncId;
object oAlarm; object oTrigger; object oChannel; object oRoom; object oFunc;
integer iOccurred; integer iLast; integer iType; integer iCounter; integer iColon;
integer iTriggerDP; integer iOps; integer iChnId;
boolean bQuittable; boolean bFirstRoom; boolean bFirstFunc;
boolean bFirst = true;

Write('[');

object oServices = dom.GetObject(ID_SERVICES);
if (oServices) {
    foreach (sAlarmId, oServices.EnumIDs()) {
        oAlarm = dom.GetObject(sAlarmId);
        sRawName = "";
        sName = "";
        sAddress = "";
        sDeviceName = "";
        sRooms = "";
        sFunctions = "";
        iOccurred = 0;
        iLast = 0;
        iType = 0;
        iCounter = 0;
        bQuittable = false;
        if (oAlarm) {
            if (oAlarm.AlState() == 1) {
                if (oAlarm.Name()) {
                    sRawName = oAlarm.Name();
                    sName = sRawName.UriEncode();
                }

                iOccurred = oAlarm.AlOccurrenceTimeSeconds();
                iLast = oAlarm.LastTimestampSeconds();
                iType = oAlarm.AlType();
                iCounter = oAlarm.AlCounter();

                !# Service-message name format is "AL-ADDRESS:CHANNEL.PARAM";
                !# extract the address prefix if the pattern matches.
                if (sRawName.Find("AL-") == 0) {
                    sRest = sRawName.Substr(3);
                    iColon = sRest.Find(":");
                    if (iColon > 0) {
                        sAddress = sRest.Substr(0, iColon);
                    }
                }

                iTriggerDP = oAlarm.AlTriggerDP();
                if (iTriggerDP) {
                    oTrigger = dom.GetObject(iTriggerDP);
                    if (oTrigger) {
                        iOps = oTrigger.Operations();
                        if (iOps & 2) {
                            bQuittable = true;
                        }
                        iChnId = oTrigger.Channel();
                        if (iChnId) {
                            oChannel = dom.GetObject(iChnId);
                            if (oChannel) {
                                if (sAddress == "") {
                                    sAddress = oChannel.Address();
                                }
                                if (oChannel.Name()) {
                                    sDeviceName = oChannel.Name().UriEncode();
                                }

                                bFirstRoom = true;
                                foreach (sRoomId, oChannel.ChnRoom()) {
                                    oRoom = dom.GetObject(sRoomId);
                                    if (oRoom) {
                                        if (bFirstRoom) {
                                            bFirstRoom = false;
                                        } else {
                                            sRooms = sRooms # ',';
                                        }
                                        sRooms = sRooms # '"' # oRoom.Name().UriEncode() # '"';
                                    }
                                }

                                bFirstFunc = true;
                                foreach (sFuncId, oChannel.ChnFunction()) {
                                    oFunc = dom.GetObject(sFuncId);
                                    if (oFunc) {
                                        if (bFirstFunc) {
                                            bFirstFunc = false;
                                        } else {
                                            sFunctions = sFunctions # ',';
                                        }
                                        sFunctions = sFunctions # '"' # oFunc.Name().UriEncode() # '"';
                                    }
                                }
                            }
                        }
                    }
                }

                if (bFirst) {
                    bFirst = false;
                } else {
                    Write(',');
                }

                Write('{"id":"' # oAlarm.ID() # '",');
                Write('"name":"' # sName # '",');
                Write('"timestamp":' # iOccurred # ',');
                Write('"type":' # iType # ',');
                Write('"address":"' # sAddress # '",');
                Write('"device_name":"' # sDeviceName # '",');
                Write('"last_timestamp":' # iLast # ',');
                Write('"counter":' # iCounter # ',');
                Write('"rooms":[' # sRooms # '],');
                Write('"functions":[' # sFunctions # '],');
                Write('"quittable":' # bQuittable # '}');
            }
        }
    }
}

Write(']');
