!# openccu-loom — set_device_rooms
!# Params: ##address## (channel or device address), ##rooms## (\n-separated
!#         room names; empty string clears every existing assignment)
!# Output: count of assignments after the update.
!#
!# Replaces the object's room assignments with the given set. Rooms not
!# found on the CCU are silently skipped — the caller refreshes the
!# device list afterwards to pick up the canonical state.
!#
!# Resolution is rename-proof: dom.GetObject(name) only matches while the
!# object's name still equals its address, so after a verify miss the
!# script scans devices and channels by Address() — the same strategy the
!# CCU's own Device.getReGaIDByAddress method uses.

string sAddress = "##address##";
string sRooms = "##rooms##";
integer iCount = 0;
string sTargetId = "";

object oByName = dom.GetObject(sAddress);
if (oByName) {
    if (oByName.Address() == sAddress) {
        sTargetId = oByName.ID();
    }
}
if (sTargetId == "") {
    object oDevices = dom.GetObject(ID_DEVICES);
    if (oDevices) {
        string sDevId;
        foreach (sDevId, oDevices.EnumIDs()) {
            object oDev = dom.GetObject(sDevId);
            if (oDev) {
                if (oDev.Address() == sAddress) {
                    sTargetId = oDev.ID();
                } else {
                    string sChnId;
                    foreach (sChnId, oDev.Channels()) {
                        object oChn = dom.GetObject(sChnId);
                        if (oChn) {
                            if (oChn.Address() == sAddress) {
                                sTargetId = oChn.ID();
                            }
                        }
                    }
                }
            }
        }
    }
}
if (sTargetId != "") {
    object oRoomList = dom.GetObject(ID_ROOMS);
    string sRoomId;
    foreach (sRoomId, oRoomList.EnumIDs()) {
        object oRoom = dom.GetObject(sRoomId);
        if (oRoom) {
            oRoom.Remove(sTargetId);
        }
    }
    string sRoomName;
    foreach (sRoomName, sRooms.Split("\n")) {
        if (sRoomName != "") {
            object oRoom = oRoomList.Get(sRoomName);
            if (oRoom) {
                oRoom.Add(sTargetId);
                iCount = iCount + 1;
            }
        }
    }
}
Write(iCount);
