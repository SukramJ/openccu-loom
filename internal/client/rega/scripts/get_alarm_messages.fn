!# openccu-loom — get_alarm_messages
!# Output: array of active alarm-message records
!#
!# Walks ID_SYSTEM_VARIABLES and emits one record per ALARMDP whose
!# AlState() is 1 (raised and not yet acknowledged):
!#   id, name, description, timestamp, last_timestamp, counter
!#
!# Alarm system variables carry no device relation. They are created by
!# the operator and raised from programs, so the CCU leaves their
!# trigger data point at the 65535 "unknown" sentinel. An
!# `if (trigger > 0)` guard does not catch 65535, so resolving a trigger
!# channel here raised a ScriptRuntimeError. Device, room and trigger
!# data belong to get_service_messages.fn, whose ID_SERVICES alarms do
!# carry a real trigger data point.
!#
!# Timestamps are Unix seconds via the *Seconds() accessors rather than
!# ToString(), which renders CCU local time with no offset and is not
!# parsable on its own. 0 means the occurrence never happened, which is
!# the normal state of last_timestamp for a variable raised once.
!#
!# Read every accessor into a typed local before building the record.
!# Calling one inline inside a Write() concatenation chain makes ReGa
!# drop the enclosing if-condition, so the script then emits a record
!# for every system variable with an empty timestamp field. Verified
!# against a live CCU: inline emits ~70 bogus records, the form below
!# emits only genuine alarms.
!#
!# Name and description go through UriEncode() because both are
!# free-form operator input and would otherwise break the JSON.

string sVarId;
boolean bFirst = true;

Write('[');

object oSysvars = dom.GetObject(ID_SYSTEM_VARIABLES);
if (oSysvars) {
    foreach (sVarId, oSysvars.EnumIDs()) {
        object oVar = dom.GetObject(sVarId);
        if (oVar && (oVar.TypeName() == "ALARMDP") && (oVar.AlState() == 1)) {

            string sName = "";
            if (oVar.Name()) {
                sName = oVar.Name().UriEncode();
            }

            string sDescription = "";
            if (oVar.DPInfo()) {
                sDescription = oVar.DPInfo().UriEncode();
            }

            integer iOccurred = oVar.AlOccurrenceTimeSeconds();
            integer iLast = oVar.LastTimestampSeconds();
            integer iCounter = oVar.AlCounter();

            if (bFirst) {
                bFirst = false;
            } else {
                Write(',');
            }

            Write('{"id":"' # oVar.ID() # '",');
            Write('"name":"' # sName # '",');
            Write('"description":"' # sDescription # '",');
            Write('"timestamp":' # iOccurred # ',');
            Write('"last_timestamp":' # iLast # ',');
            Write('"counter":' # iCounter # '}');
        }
    }
}

Write(']');
