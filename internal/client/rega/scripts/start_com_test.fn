!# openccu-loom — start_com_test
!# Params: ##address## (device or channel address)
!# Output: JSON { "success": bool, "started": "<Y-m-d H:M:S>", "error": "..." }
!#
!# Starts the CCU's communication/function test for the device: the
!# interface process sends a radio test frame to the device and awaits an
!# ACK. Resolution is rename-proof (name lookup, then an address scan over
!# devices), like set_device_rooms.fn.
!#
!# oDev is shared between the address scan and the test start; the two
!# branches are mutually exclusive and each assigns it before reading it.

string sAddress = "##address##";
string sTargetId = "";
string sDevId; string sStarted;
object oByName; object oDevices; object oDev;

oByName = dom.GetObject(sAddress);
if (oByName) {
    if (oByName.Address() == sAddress) {
        sTargetId = oByName.ID();
    }
}
if (sTargetId == "") {
    oDevices = dom.GetObject(ID_DEVICES);
    if (oDevices) {
        foreach (sDevId, oDevices.EnumIDs()) {
            oDev = dom.GetObject(sDevId);
            if (oDev) {
                if (oDev.Address() == sAddress) {
                    sTargetId = oDev.ID();
                }
            }
        }
    }
}
if (sTargetId == "") {
    Write("{\"success\":false,\"error\":\"device not found\"}");
} else {
    oDev = dom.GetObject(sTargetId);
    sStarted = system.Date("%Y-%m-%d %H:%M:%S");
    oDev.DevStartComTest();
    Write("{\"success\":true,\"started\":\"" # sStarted # "\"}");
}
