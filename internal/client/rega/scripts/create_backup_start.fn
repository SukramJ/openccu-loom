!# name: create_backup_start.fn
!#
!# This script starts a system backup in the background.
!# It returns immediately without waiting for completion.
!# Use create_backup_status.fn to check the backup status.
!#
!# The backup file is written to /usr/local/tmp/last_backup.sbk, where
!# create_backup_status.fn picks up its name and size and then removes it —
!# see that script for why the archive does not stay.
!# Works for OpenCCU.
!#

string sPid = "";

!# Remove any existing backup file, pid file and completion markers. The
!# markers are what create_backup_status.fn answers "completed" from once it
!# has cleaned up the archive, so a stale pair would report the previous
!# backup as this run's result for as long as this one takes to finish.
system.Exec("/bin/sh -c 'rm -f /usr/local/tmp/last_backup.sbk /usr/local/tmp/backup.pid /usr/local/tmp/backup.done /usr/local/tmp/backup.done.size'");

!# Start backup in background using nohup
!# Save the PID to a file for status checking
system.Exec("/bin/sh -c 'nohup /bin/sh -c \"/bin/createBackup.sh /usr/local/tmp/last_backup.sbk; rm -f /usr/local/tmp/backup.pid\" > /dev/null 2>&1 & echo $! > /usr/local/tmp/backup.pid'");

!# Verify the process was started
system.Exec("test -f /usr/local/tmp/backup.pid && cat /usr/local/tmp/backup.pid", &sPid);
sPid = sPid.Trim();

if (sPid != "") {
    Write('{"success":true,"status":"started","pid":"' # sPid # '"}');
} else {
    Write('{"success":false,"status":"failed","message":"Failed to start backup process"}');
}