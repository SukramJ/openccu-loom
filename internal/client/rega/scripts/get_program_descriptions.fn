!# openccu-loom — get_program_descriptions
!# Output: [{"id":"<program-id>","description":"<uri-encoded info>",
!#          "condition_summary":"<uri-encoded>","activity_summary":"<uri-encoded>"}...]
!#
!# Walks every registered program and emits its PrgInfo description plus a
!# compact, language-neutral summary of the program's root rule: the
!# trigger conditions (condition_summary) and the resulting activities
!# (activity_summary). Object names are taken from the ReGa DOM; the
!# comparison and logical operators are rendered as symbols (==, >=, <=,
!# >, <, &&, ||, :=) so the strings need no translation on the client.
!# Only the root ("if") rule is summarised to keep the payload small;
!# else-if sub-rules are omitted. Every field is URL-encoded because
!# names and info strings may contain quotes, backslashes, or newlines
!# that would otherwise break the JSON framing.
!#
!# sName and oLV are shared between the condition and the activity pass.
!# The two passes run in sequence, never nested, and each pass assigns
!# both before reading them.

string sProgramId; string sDescription; string sCond; string sAct;
string sCondIdx; string sSingleIdx; string sDestIdx; string sName;
object oProgram; object oRule; object oC; object oSC; object oCC; object oLV;
object oDest; object oSD; object oCH;
integer iCondCount; integer iSingleCount; integer iLVT; integer iCT;
integer iRV1; integer iRV2; integer iDestCount; integer iP; integer iV;
boolean bValue;
boolean bFirst = true;

Write('[');
foreach (sProgramId, dom.GetObject(ID_PROGRAMS).EnumIDs()) {
    oProgram = dom.GetObject(sProgramId);
    if (oProgram) {
        sDescription = oProgram.PrgInfo().UriEncode();
        sCond = "";
        sAct = "";

        oRule = oProgram.Rule();
        if (oRule) {
            ! --- trigger conditions ---
            iCondCount = oRule.RuleConditions().Count();
            if (iCondCount > 0) {
                foreach (sCondIdx, system.GenerateEnum(0, iCondCount - 1)) {
                    oC = oRule.RuleCondition(sCondIdx);
                    if (oC) {
                        iSingleCount = oC.CndSingleCount();
                        if (iSingleCount > 0) {
                            foreach (sSingleIdx, system.GenerateEnum(0, iSingleCount - 1)) {
                                oSC = oC.CndSingleCondition(sSingleIdx);
                                if (oSC) {
                                    if (sSingleIdx.ToInteger() > 0) {
                                        if (oSC.OperatorType() == 2) { sCond = sCond # " || "; }
                                        else { sCond = sCond # " && "; }
                                    }
                                    iLVT = oSC.LeftValType();
                                    sName = "?";
                                    bValue = false;
                                    if (iLVT == ivtObjectId) {
                                        oCC = dom.GetObject(oSC.ConditionChannel());
                                        if (oCC) { sName = oCC.Name(); }
                                        bValue = true;
                                    }
                                    if (iLVT == ivtSystemId) {
                                        oLV = dom.GetObject(oSC.LeftVal());
                                        if (oLV) { sName = oLV.Name(); }
                                        bValue = true;
                                    }
                                    if (iLVT == ivtCurrentDate) {
                                        sName = "@time";
                                    }
                                    sCond = sCond # sName;
                                    if (bValue) {
                                        iCT = oSC.ConditionType();
                                        iRV1 = oSC.RightVal1();
                                        iRV2 = oSC.RightVal2();
                                        if (iCT == 5) { sCond = sCond # " == " # iRV1.ToString(2); }
                                        if ((iCT == 6) || (iCT == 7)) { sCond = sCond # " [" # iRV1.ToString(2) # ".." # iRV2.ToString(2) # "]"; }
                                        if (iCT == 8) { sCond = sCond # " > " # iRV1.ToString(2); }
                                        if (iCT == 9) { sCond = sCond # " >= " # iRV1.ToString(2); }
                                        if (iCT == 10) { sCond = sCond # " < " # iRV1.ToString(2); }
                                        if (iCT == 11) { sCond = sCond # " <= " # iRV1.ToString(2); }
                                    }
                                }
                            }
                        }
                        if (sCondIdx.ToInteger() < (iCondCount - 1)) {
                            if (oC.CndOperatorType() == 2) { sCond = sCond # " || "; }
                            else { sCond = sCond # " && "; }
                        }
                    }
                }
            }

            ! --- resulting activities ---
            oDest = oRule.RuleDestination();
            if (oDest) {
                iDestCount = oDest.DestSingleCount();
                if (iDestCount > 0) {
                    foreach (sDestIdx, system.GenerateEnum(0, iDestCount - 1)) {
                        oSD = oDest.DestSingleDestination(sDestIdx);
                        if (oSD) {
                            if (sDestIdx.ToInteger() > 0) { sAct = sAct # "; "; }
                            iP = oSD.DestinationParam();
                            if (iP == ivtString) {
                                sAct = sAct # "@script";
                            }
                            else {
                                sName = "?";
                                if (iP == ivtSystemId) {
                                    oLV = dom.GetObject(oSD.DestinationDP());
                                    if (oLV) { sName = oLV.Name(); }
                                }
                                if (iP == ivtObjectId) {
                                    oCH = dom.GetObject(oSD.DestinationChannel());
                                    if (oCH) { sName = oCH.Name(); }
                                }
                                iV = oSD.DestinationValue();
                                sAct = sAct # sName # " := " # iV.ToString(2);
                            }
                        }
                    }
                }
            }
        }

        if (bFirst) {
            bFirst = false;
        } else {
            WriteLine(',');
        }

        Write('{"id":"' # sProgramId # '","description":"' # sDescription # '","condition_summary":"' # sCond.UriEncode() # '","activity_summary":"' # sAct.UriEncode() # '"}');
    }
}
Write(']');
