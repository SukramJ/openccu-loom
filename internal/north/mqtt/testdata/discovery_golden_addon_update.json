        ],
        "manufacturer": "OpenCCU-Loom",
        "model": "Daemon",
        "name": "OpenCCU-Loom"
      },
      "enabled_by_default": true,
      "entity_category": "diagnostic",
      "latest_version_template": "{{ value_json.val.latest_version }}",
      "latest_version_topic": "openccu-loom/status/system/addon_update",
      "name": "Add-on Update",
      "origin": {
        "name": "openccu-loom",
        "support_url": "https://github.com/SukramJ/openccu-loom",
        "sw_version": "dev"
