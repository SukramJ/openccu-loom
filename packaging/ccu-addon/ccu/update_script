#
# CCU / OpenCCU add-on install + update hook. The CCU's
# "Additional Software" page unpacks the tarball and runs this script
# with the platform identifier as $1 (CCU2 / HM-RASPBERRYMATIC / CCU3).
#
# HM-RASPBERRYMATIC is what OpenCCU still passes -- see
# buildroot-external/overlay/base/bin/install_addon and the recovery path in
# package/recovery-system/.../fwinstall.sh, both of which call
# `update_script HM-RASPBERRYMATIC`, and release/LATEST-VERSION.js which
# carries the same product key. It is a value we RECEIVE, not a name we give,
# so it stays; HM-OPENCCU is accepted alongside for the day that changes.
#
# The tarball ships both ARM builds (openccu-loom.armv7 + .arm64); the
# matching one is selected here from `uname -m` so a single package
# installs on CCU3 (armv7l) and 64-bit OpenCCU (aarch64).

set -e

ADDON_ID=openccu-loom
ADDON_NAME="OpenCCU-Loom"
ADDON_DESCR_EN="OpenCCU-Loom bridges Homematic CCUs to MQTT, a REST + WebSocket API, a Config UI, and a Matter bridge."
ADDON_DESCR_DE="OpenCCU-Loom verbindet Homematic-CCUs mit MQTT, einer REST- und WebSocket-API, einer Konfigurations-UI und einer Matter-Bridge."

ADDON_DIR=/usr/local/addons/${ADDON_ID}
ETC_DIR=/usr/local/etc
RCD_DIR=/usr/local/etc/config/rc.d
WWW_DIR=/usr/local/etc/config/addons/www/${ADDON_ID}

# Mount the writable partition that holds /usr/local across reboots.
if [ "$1" = "" ]; then
  echo "${ADDON_NAME} requires CCU3 or OpenCCU"
  lcdtool "Add-On needs CCU3/RM    " 2>/dev/null || true
  exit 1
elif [ "$1" = "CCU2" ]; then
  echo "${ADDON_NAME} requires CCU3 or OpenCCU (CCU2 is unsupported)"
  exit 1
elif [ "$1" = "HM-RASPBERRYMATIC" ] || [ "$1" = "HM-OPENCCU" ] || [ "$1" = "CCU3" ]; then
  echo "Installing on CCU3 / OpenCCU"
  mount /usr/local 2>/dev/null || true
fi

# Select the binary for this CPU architecture. OpenCCU ships for
# armv7 (CCU3 / Pi), aarch64 (64-bit Pi) and x86-64 (OVA / generic).
ARCH=$(uname -m)
case "${ARCH}" in
  x86_64|amd64)         ADDON_BIN=openccu-loom.amd64 ;;
  aarch64|arm64)        ADDON_BIN=openccu-loom.arm64 ;;
  armv7l|armv6l|armhf)  ADDON_BIN=openccu-loom.armv7 ;;
  *)
    echo "Unsupported architecture: ${ARCH}"
    exit 1
  ;;
esac

# Stop a previous installation before overwriting its files.
if [ -f ${RCD_DIR}/${ADDON_ID} ]; then
  echo "Previous installation detected — stopping"
  ${RCD_DIR}/${ADDON_ID} stop 2>/dev/null || true
fi

mkdir -p ${ADDON_DIR} ${RCD_DIR} ${WWW_DIR} ${ETC_DIR}
chmod 755 ${ADDON_DIR} ${RCD_DIR} ${WWW_DIR}

# Install the daemon binary under a stable name, plus the support files.
cp -af addon/${ADDON_BIN} ${ADDON_DIR}/${ADDON_ID}
chmod 755 ${ADDON_DIR}/${ADDON_ID}
cp -af addon/VERSION ${ADDON_DIR}/VERSION 2>/dev/null || true
cp -af addon/assets ${ADDON_DIR}/ 2>/dev/null || true
cp -af rc.d/* ${RCD_DIR}/
cp -af www/* ${WWW_DIR}/
cp -af etc/* ${ETC_DIR}/
chmod 755 ${RCD_DIR}/${ADDON_ID}

# Persistent data dir for the SQLite DB + filesystem state.
mkdir -p ${ADDON_DIR}/var
chmod 755 ${ADDON_DIR}/var

# Register the add-on's control-panel tile ("Systemsteuerung"). The WebUI
# renders one button per entry of /etc/config/hm_addons.cfg; entries are
# written by the platform helper /bin/updateAddonConfig.tcl, or — on
# firmware that predates it — by the underlying HomeMatic Tcl API the
# helper itself calls. Neither is vendored here (platform code), so both
# are probed. A miss is announced rather than swallowed: the daemon runs
# fine without the tile, but a silent skip is indistinguishable from a
# broken install.
register_menu_tcl() {
  cat <<EOF
package require HomeMatic
::HomeMatic::Addon::AddConfigPage "${ADDON_ID}" "/addons/${ADDON_ID}/config.cgi" "${ADDON_NAME}" [list de "<li>${ADDON_DESCR_DE}</li>" en "<li>${ADDON_DESCR_EN}</li>"]
EOF
}

register_menu() {
  if [ -x /bin/updateAddonConfig.tcl ]; then
    if /bin/updateAddonConfig.tcl -a ${ADDON_ID} -name "${ADDON_NAME}" \
         -url /addons/${ADDON_ID}/config.cgi \
         -de "${ADDON_DESCR_DE}" -en "${ADDON_DESCR_EN}"; then
      return 0
    fi
  fi
  if [ -x /bin/tclsh ] && register_menu_tcl | /bin/tclsh; then
    return 0
  fi
  echo "Warning: could not register the ${ADDON_NAME} control panel entry"
  return 0
}

register_menu

sync
echo "Installed ${ADDON_NAME} (${ADDON_BIN})"

# OpenCCU runs this script live via /bin/install_addon
# and honour the exit code: 0 = installed without reboot, 10 = reboot
# required. Nothing here needs a boot-time hook (no ReGa patch, no
# interface registration), so start the daemon in place and hand the
# new monit config to the running monit instead of rebooting the CCU.
# monit (active mode) is the supervisor, so a failed inline start is
# recovered on its next cycle — hence the tolerant `|| true`.
if [ "$1" = "HM-RASPBERRYMATIC" ] || [ "$1" = "HM-OPENCCU" ]; then
  ${RCD_DIR}/${ADDON_ID} init 2>/dev/null || true
  if [ -x /usr/bin/monit ]; then
    monit reload 2>/dev/null || true
  fi
  exit 0
fi

# Stock CCU3 firmware reboots unconditionally on add-on install and runs
# this script during the following boot; starting the daemon inline there
# would collide with the rc.d init that follows later in the same boot.
# Keep the conventional reboot-request exit code on that path.
exit 10
