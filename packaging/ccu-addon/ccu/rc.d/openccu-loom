#
# CCU / OpenCCU rc.d service script for OpenCCU-Loom. Started by
# the CCU at boot via `init`, supervised by monit (see
# etc/monit-openccu-loom.cfg), and driven from the add-on web page.
#
# On openccu-lite the same script runs inside a oneshot systemd unit
# (addon-openccu-loom.service), confined to the add-on's own user, and there
# is no monit. Three things differ there, all decided below: the pidfile
# lives in the unit's runtime directory, the script supervises the daemon
# itself, and it does so only inside that unit.

ADDON_ID=openccu-loom
ADDON_NAME="OpenCCU-Loom"
ADDON_COPYRIGHT="(c) 2026 SukramJ"
ADDON_WWW='<a href="https://github.com/SukramJ/openccu-loom" target="_blank">https://github.com/SukramJ/openccu-loom</a>'

# The LOOM_RC_* overrides exist for tests/contract/ccu_addon_rc_script_test.go
# only; a CCU never sets them.
ADDON_DIR=${LOOM_RC_ADDON_DIR:-/usr/local/addons/${ADDON_ID}}
ETC_DIR=/usr/local/etc
RCD_DIR=/usr/local/etc/config/rc.d
WWW_DIR=/usr/local/etc/config/addons/www/${ADDON_ID}
MONIT=${LOOM_RC_MONIT:-/usr/bin/monit}
CGROUP_FILE=${LOOM_RC_CGROUP:-/proc/self/cgroup}
CRON_BACKUP_PATH_FILE=${LOOM_RC_CRON_BACKUP_PATH_FILE:-/usr/local/etc/config/CronBackupPath}

# The pidfile must be writable by the user the daemon runs as. On a CCU that
# is root and /var/run. openccu-lite runs the add-on as its own user, for
# whom /run is read-only, and gives the unit /run/addon-<id> instead. A
# pidfile the script cannot write is silently never refreshed: stop then
# signals whatever process the stale file names, and never the daemon.
RUN_DIR=${LOOM_RC_RUN_DIR:-/var/run}
if [ -z "${LOOM_RC_RUN_DIR}" ] && [ -d /run/addon-${ADDON_ID} ]; then
  RUN_DIR=/run/addon-${ADDON_ID}
fi
PIDFILE=${RUN_DIR}/${ADDON_ID}.pid

# Runtime configuration. The daemon is otherwise UI-configured — these
# only pin the bootstrap tier (data dir, bind ports). Edit here to move a
# port that clashes with another add-on. UI is the SPA + REST + the
# pre-auth bootstrap surface, all on :8119; CCU callbacks on :8120/:8129.
export OPENCCU_LOOM_DATA_DIR=${ADDON_DIR}/var
export OPENCCU_LOOM_REST_LISTEN=:8119
export OPENCCU_LOOM_LOG_FORMAT=text
# Note: the callback host is resolved per-central by the daemon (egress
# interface toward each CCU), so a co-located CCU automatically gets
# loopback and an external CCU gets the LAN IP. No global override is set
# here — that would force one host for all centrals and break a mixed
# local+external setup. Set OPENCCU_LOOM_CALLBACK_PUBLIC_HOST only for a
# genuine NAT scenario where every CCU reaches the daemon at one address.
# Tell the daemon it runs under a supervisor so the SPA "Restart" action
# is enabled: a restart SIGTERMs the process, and monit (active mode, see
# etc/monit-openccu-loom.cfg) brings it back up on the next cycle — or,
# where there is no monit, the script's own loop (see supervise). Without
# this the daemon cannot detect monit and disables restart to avoid
# leaving itself offline.
export OPENCCU_LOOM_SUPERVISOR=1

# has_monit reports whether monit supervises the daemon. Without it nothing
# would start the daemon again after a restart from the SPA: the openccu-lite
# unit is a oneshot that stays "active" with the daemon gone.
has_monit() {
  [ -x "${MONIT}" ]
}

# in_addon_unit reports whether this process runs inside the add-on's own
# systemd unit, read off its cgroup (cgroup v2 has the one line
# "0::<path>"; on v1 every controller line carries the same path).
in_addon_unit() {
  [ -r "${CGROUP_FILE}" ] || return 1
  while IFS=: read -r _id _ctl path; do
    case "${path}" in
      */addon-${ADDON_ID}.service|*/addon-${ADDON_ID}.service/*) return 0 ;;
    esac
  done < "${CGROUP_FILE}"
  return 1
}

# supervise runs the daemon and starts it again whenever it exits, until it
# is itself told to stop. It is the pidfile's process where there is no
# monit; a TERM is passed on to the daemon, and the loop ends once the
# daemon has shut down.
supervise() {
  child=
  trap 'if [ -n "${child}" ]; then kill -TERM "${child}" 2>/dev/null; wait "${child}"; fi; exit 0' TERM INT
  while :; do
    "${ADDON_DIR}/${ADDON_ID}" run &
    child=$!
    wait "${child}"
    child=
    logger -t ${ADDON_ID} -p user.info "Daemon exited, starting it again"
    sleep 2
  done
}

# own_pid echoes the pidfile's PID when that process is still ours — the
# daemon or its supervising loop, both of which name the add-on in their
# command line. A PID the kernel has handed to another program since is
# not signalled.
own_pid() {
  [ -r "${PIDFILE}" ] || return 1
  pid=$(cat "${PIDFILE}" 2>/dev/null)
  case "${pid}" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "${pid}" 2>/dev/null || return 1
  tr '\000' ' ' < /proc/${pid}/cmdline 2>/dev/null | grep -q "${ADDON_ID}" || return 1
  echo "${pid}"
}

# resolve_backup_dir echoes where the downloaded CCU archives belong.
#
# The default, ${ADDON_DIR}/var/backups, is the one place they must not
# stay on a CCU: /usr/local is exactly the tree createBackup.sh and the
# WebUI's create_backup CGI pack into an .sbk, so every CCU backup would
# carry all previously downloaded archives, and the next one would carry
# those again. It is also the internal flash on most installs.
#
# The order mirrors cronBackup.sh, so the archives land beside the CCU's
# own: an operator-set path wins, otherwise external storage when the
# system reports some. /usr/local/sdcard looks like it contradicts the
# rule but does not: on an OVA it is its own mount, and both tar runs pass
# --one-file-system, so they stop at its boundary. Falling through to the
# empty string leaves the daemon on its default, which still carries the
# .nobackup marker those tar runs honour — degraded, not broken.
resolve_backup_dir() {
  if [ -s "${CRON_BACKUP_PATH_FILE}" ]; then
    head -n1 "${CRON_BACKUP_PATH_FILE}"
    return
  fi
  if [ -e /var/status/hasUSB ] && [ -d /media/usb0 ]; then
    echo /media/usb0/backup
    return
  fi
  if [ -d /usr/local/sdcard ]; then
    echo /usr/local/sdcard/backup
    return
  fi
  echo ""
}

# dir_writable reports whether this process can write into dir, or create
# it below its nearest existing parent. On openccu-lite the add-on's unit
# mounts /usr/local read-only except for the add-on's own directories, so
# /usr/local/sdcard exists but can never take an archive there.
dir_writable() {
  d=$1
  while [ ! -d "${d}" ]; do
    d=$(dirname "${d}")
  done
  [ -w "${d}" ]
}

stop() {
  logger -t ${ADDON_ID} -p user.debug "Stopping"
  if pid=$(own_pid); then
    kill -TERM "${pid}" 2>/dev/null
    # On TERM the daemon drains its HTTP surface and closes its stores;
    # wait for it to exit rather than a fixed time, bounded at 30 s.
    n=0
    while kill -0 "${pid}" 2>/dev/null && [ ${n} -lt 30 ]; do
      sleep 1
      n=$((n + 1))
    done
  fi
  rm -f "${PIDFILE}"
  logger -t ${ADDON_ID} -p user.info "Stopped"
}

start() {
  logger -t ${ADDON_ID} -p user.debug "Starting"
  # Decided before anything else is resolved — only the debug "Starting"
  # trace above precedes it — so a start that does not happen reports
  # nothing it would have done.
  #
  # Without monit the supervising loop has to live in the add-on's unit,
  # which stops it with the unit. Anywhere else nothing would: the
  # installer runs this script as root in its own scope, and a loop started
  # there survived the install and kept starting a second daemon as root.
  # The platform starts the unit itself after an install.
  if ! has_monit && ! in_addon_unit; then
    logger -t ${ADDON_ID} -p user.info "No monit and not inside addon-${ADDON_ID}.service: the unit starts the daemon"
    return 0
  fi
  if own_pid >/dev/null; then
    logger -t ${ADDON_ID} -p user.info "Already running"
    return 0
  fi
  # Resolved per start, not once at script load: an operator can plug in a
  # USB stick or set CronBackupPath between two starts, and a restart is
  # what the SPA tells them a directory change needs anyway.
  BACKUP_DIR=$(resolve_backup_dir)
  if [ -n "${BACKUP_DIR}" ] && ! dir_writable "${BACKUP_DIR}"; then
    logger -t ${ADDON_ID} -p user.info "${BACKUP_DIR} is not writable here"
    BACKUP_DIR=""
  fi
  if [ -n "${BACKUP_DIR}" ]; then
    export OPENCCU_LOOM_BACKUP_DIR=${BACKUP_DIR}
    logger -t ${ADDON_ID} -p user.info "CCU archives go to ${BACKUP_DIR}"
  else
    logger -t ${ADDON_ID} -p user.info "No CCU backup target found, keeping archives in ${ADDON_DIR}/var/backups"
  fi
  cd ${ADDON_DIR}
  if has_monit; then
    # -b: background, -m: write the pidfile for start-stop-daemon's child.
    start-stop-daemon -S -q -b -m -p ${PIDFILE} \
      -x ${ADDON_DIR}/${ADDON_ID} -- run
  else
    # exec inside the subshell, not a redirection on the call: a shell
    # keeps copies of the caller's descriptors around a redirected function
    # call, and the loop would hold the installer's or the unit's output
    # open for as long as it runs.
    (
      exec </dev/null >/dev/null 2>&1
      supervise
    ) &
    # A pidfile another user left behind cannot be overwritten, but the
    # runtime directory is the add-on's own, so it can be replaced.
    rm -f "${PIDFILE}"
    echo $! > "${PIDFILE}"
  fi
  logger -t ${ADDON_ID} -p user.info "Started"
}

info() {
  echo "Info: <b>${ADDON_NAME} Add-On</b><br>"
  echo "Info: ${ADDON_COPYRIGHT}<br>"
  echo "Info: ${ADDON_WWW}"
  echo "Name: ${ADDON_NAME}"
  echo "Version: $(cat ${ADDON_DIR}/VERSION 2>/dev/null || echo unknown)"
  echo "Operations: uninstall restart"
  echo "Config-Url: /addons/${ADDON_ID}/config.cgi"
  echo "Update: /addons/${ADDON_ID}/update-check.cgi"
}

# unregister_menu drops the control-panel tile from
# /etc/config/hm_addons.cfg. Mirrors the registration in update_script:
# platform helper first, the HomeMatic Tcl API as the fallback. The API
# call is guarded by an `info procs` probe because RemoveConfigPage is a
# OpenCCU addition — stock firmware only ships
# AddConfigPage, and an unguarded call would abort the uninstall.
unregister_menu_tcl() {
  cat <<EOF
package require HomeMatic
if {[info procs ::HomeMatic::Addon::RemoveConfigPage] ne ""} {
  ::HomeMatic::Addon::RemoveConfigPage "${ADDON_ID}"
}
EOF
}

unregister_menu() {
  if [ -x /bin/updateAddonConfig.tcl ]; then
    if /bin/updateAddonConfig.tcl -d ${ADDON_ID}; then
      return 0
    fi
  fi
  if [ -x /bin/tclsh ]; then
    unregister_menu_tcl | /bin/tclsh || true
  fi
  return 0
}

uninstall() {
  logger -t ${ADDON_ID} -p user.debug "Uninstalling"
  if [ -x /usr/bin/monit ]; then
    monit unmonitor ${ADDON_ID} 2>/dev/null || true
  fi
  stop
  unregister_menu
  rm -f ${RCD_DIR}/${ADDON_ID}
  rm -f ${ETC_DIR}/monit-${ADDON_ID}.cfg
  rm -rf ${ADDON_DIR}
  rm -rf ${WWW_DIR}
  if [ -x /usr/bin/monit ]; then
    monit reload 2>/dev/null || true
  fi
  logger -t ${ADDON_ID} -p user.info "Uninstalled"
}

case "$1" in
  ""|init)   start ;;
  start)     echo "use init to start" ;;
  stop)      stop ;;
  restart|reload) stop; start ;;
  uninstall) uninstall ;;
  info)      info ;;
  *)
    echo "usage: ${ADDON_ID} [init|start|stop|restart|uninstall|info]" >&2
    exit 1
  ;;
esac

exit $?
