    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@lucide/svelte": "^1.9.0",
    "bits-ui": "^1.0.0",
