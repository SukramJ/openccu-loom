{
  "name": "openccu-loom-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Svelte 5 SPA for OpenCCU-Loom — data-driven CCU config UI",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0205 vite",
    "build": "NODE_OPTIONS=--disable-warning=DEP0205 vite build",
    "preview": "NODE_OPTIONS=--disable-warning=DEP0205 vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript ../openapi.yaml -o src/lib/api/types.generated.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^20.11.0",
    "openapi-typescript": "^7.13.0",
    "opentype.js": "^2.0.0",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.6.0"
  }
}
