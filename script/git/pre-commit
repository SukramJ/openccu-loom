#
# pre-commit — runs format + build + vet + lint + fast tests against the
# staged Go changes. Installed by `make setup` into .git/hooks/pre-commit.
#
# Goals:
#   - Auto-format with gofumpt + goimports and re-stage the affected files
#     so commits never carry style noise.
#   - Catch the most common breakages early without being so slow that
#     developers start passing --no-verify.
#   - Skip the heavy stuff (race, integration tests, full test matrix) —
#     CI runs those separately. The hook stays under ~30 s on a warm
#     Go build cache.
#
# Skip / override:
#   GOHM_PRECOMMIT_SKIP=1            skip the entire hook
#   GOHM_PRECOMMIT_SKIP_TESTS=1      skip the contract test stage
#   GOHM_PRECOMMIT_SKIP_LINT=1       skip golangci-lint
#   GOHM_PRECOMMIT_ALLOW_MAIN=1      allow a commit on the main branch
#   GIT_SKIP_HOOKS / git --no-verify standard escape hatches
#
# Output is colourised when stderr is a TTY.

set -euo pipefail

if [[ "${GOHM_PRECOMMIT_SKIP:-0}" == "1" ]]; then
    echo "pre-commit: GOHM_PRECOMMIT_SKIP=1, skipping all checks" >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# Colour helpers — quiet when stderr is redirected.
# ---------------------------------------------------------------------------
if [[ -t 2 ]]; then
    C_RED=$'\e[0;31m'; C_GRN=$'\e[0;32m'; C_YLW=$'\e[0;33m'
    C_CYN=$'\e[0;36m'; C_DIM=$'\e[0;90m'; C_RST=$'\e[0m'
else
    C_RED=""; C_GRN=""; C_YLW=""; C_CYN=""; C_DIM=""; C_RST=""
fi

step()  { printf "%s» %s%s\n" "$C_CYN" "$1" "$C_RST" >&2; }
ok()    { printf "%s  ✓ %s%s\n" "$C_GRN" "$1" "$C_RST" >&2; }
warn()  { printf "%s  ! %s%s\n" "$C_YLW" "$1" "$C_RST" >&2; }
fail()  { printf "%s  ✗ %s%s\n" "$C_RED" "$1" "$C_RST" >&2; }
note()  { printf "%s    %s%s\n" "$C_DIM" "$1" "$C_RST" >&2; }

# ---------------------------------------------------------------------------
# Tool resolution — prefer GOPATH/bin, fall back to PATH.
# ---------------------------------------------------------------------------
GOBIN="$(go env GOPATH 2>/dev/null)/bin"
PATH="${GOBIN}:${PATH}"
export PATH

GOFUMPT_BIN="${GOFUMPT:-gofumpt}"
GOIMPORTS_BIN="${GOIMPORTS:-goimports}"
GOLANGCI_BIN="${GOLANGCI_LINT:-golangci-lint}"
MODULE_PATH="$(awk '/^module /{print $2; exit}' go.mod)"

require_bin() {
    if ! command -v "$1" >/dev/null 2>&1; then
        fail "$1 not found on PATH (PATH=$PATH)"
        note "install with: make setup"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Stage 0a — branch guard. main is protected (CLAUDE.md: no direct
# commits to main); every change lands through a feature branch + PR.
# Detached HEAD (rebase/cherry-pick in progress) is deliberately
# allowed — those commits replay onto a branch afterwards.
# ---------------------------------------------------------------------------
current_branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ "$current_branch" == "main" && "${GOHM_PRECOMMIT_ALLOW_MAIN:-0}" != "1" ]]; then
    fail "commit on 'main' blocked — main only moves through merged PRs"
    note "create a branch first:  git switch -c feature/<desc>"
    note "carry this commit over: git switch -c feature/<desc> && git commit ..."
    note "override once (maintainer): GOHM_PRECOMMIT_ALLOW_MAIN=1 git commit ..."
    exit 1
fi

# ---------------------------------------------------------------------------
# Stage 0a — refuse staged credential files.
#
# .gitignore already lists these, but an ignore rule only protects a file
# that is untracked: once something puts one in the index, `git add -A`
# keeps carrying it and the next commit ships the secret. That happened
# once, and the file reached a remote branch before it was noticed.
#
# This check is deliberately not behind any GOHM_PRECOMMIT_SKIP_* switch:
# the skips exist to trade thoroughness for speed, and a leaked credential
# is not a speed trade. `git commit --no-verify` still bypasses it, which
# is a conscious act rather than an accident.
# ---------------------------------------------------------------------------
mapfile -t STAGED_SECRETS < <(
    git diff --cached --name-only --diff-filter=ACMR 2>/dev/null |
        grep -E '(^|/)\.(ccu|mqtt)_cred$|(^|/)secret\.key$|(^|/)\.env$' || true
)
if [[ ${#STAGED_SECRETS[@]} -gt 0 ]]; then
    fail "refusing to commit credential files:"
    for f in "${STAGED_SECRETS[@]}"; do
        printf '    %s\n' "$f" >&2
    done
    printf '  unstage them with: git rm --cached %s\n' "${STAGED_SECRETS[0]}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Stage 0 — collect staged Go files.
# ---------------------------------------------------------------------------
mapfile -t STAGED_GO < <(git diff --cached --name-only --diff-filter=ACMR -- '*.go' 2>/dev/null || true)

if [[ ${#STAGED_GO[@]} -eq 0 ]]; then
    note "no staged Go files; skipping format/lint/test stages"
    NO_GO=1
else
    NO_GO=0
fi

# ---------------------------------------------------------------------------
# Stage 1 — format (gofumpt + goimports). Re-stages mutated files so the
# commit contains the formatted versions instead of failing the user.
# ---------------------------------------------------------------------------
if [[ $NO_GO -eq 0 ]]; then
    step "gofumpt + goimports"
    require_bin "$GOFUMPT_BIN"
    require_bin "$GOIMPORTS_BIN"

    formatted=()
    for f in "${STAGED_GO[@]}"; do
        [[ -f "$f" ]] || continue
        before_hash="$(git hash-object "$f")"
        "$GOFUMPT_BIN" -w "$f"
        "$GOIMPORTS_BIN" -w -local "$MODULE_PATH" "$f"
        after_hash="$(git hash-object "$f")"
        if [[ "$before_hash" != "$after_hash" ]]; then
            formatted+=("$f")
        fi
    done

    if [[ ${#formatted[@]} -gt 0 ]]; then
        warn "auto-formatted ${#formatted[@]} file(s); re-staging"
        for f in "${formatted[@]}"; do
            note "$f"
            git add -- "$f"
        done
    else
        ok "all staged files already gofumpt-clean"
    fi
fi

# ---------------------------------------------------------------------------
# Stage 2 — go vet (covers obvious mistakes, very fast).
# ---------------------------------------------------------------------------
step "go vet ./..."
if ! go vet ./... 2>&1 | sed 's/^/    /' >&2; then
    fail "go vet failed; fix the issues above before committing"
    exit 1
fi
ok "go vet clean"

# ---------------------------------------------------------------------------
# Stage 3 — go build (ensures the tree compiles, including test packages).
# ---------------------------------------------------------------------------
step "go build ./..."
if ! go build ./... 2>&1 | sed 's/^/    /' >&2; then
    fail "go build failed"
    exit 1
fi
ok "build clean"

# ---------------------------------------------------------------------------
# Stage 4 — golangci-lint on staged files only (fast incremental mode).
# Skippable via GOHM_PRECOMMIT_SKIP_LINT=1 for tight inner loops.
# ---------------------------------------------------------------------------
if [[ "${GOHM_PRECOMMIT_SKIP_LINT:-0}" == "1" ]]; then
    warn "lint skipped via GOHM_PRECOMMIT_SKIP_LINT=1"
elif [[ $NO_GO -eq 0 ]]; then
    step "golangci-lint (incremental, --new-from-rev=HEAD)"
    if ! command -v "$GOLANGCI_BIN" >/dev/null 2>&1; then
        warn "$GOLANGCI_BIN not installed; skipping lint stage"
        note "install with: make setup"
    else
        # Scope the run to the packages touched by the staged change rather
        # than the whole module. `run ./...` type-checks and builds SSA for
        # every package before --new-from-rev filtering; on a cold analysis
        # cache (first commit after a checkout) that alone blows past the
        # timeout — golangci-lint prints "0 issues" and then fails with
        # "Timeout exceeded", so a clean change is rejected. Scoping keeps the
        # cold-cache cost proportional to the change with no loss of coverage:
        # --new-from-rev=HEAD only reports issues on changed lines, and those
        # live exclusively in the staged packages. The generous --timeout is a
        # safety net for a large staged set built from cold.
        declare -A lint_pkg_set=()
        for f in "${STAGED_GO[@]}"; do
            lint_pkg_set["./$(dirname -- "$f")/..."]=1
        done
        mapfile -t lint_pkgs < <(printf '%s\n' "${!lint_pkg_set[@]}" | sort)
        # Build tags of every gated suite in the repo. Without them a staged
        # change under a fully gated package (tests/chiptool, tests/loadtest,
        # tests/bench …) makes golangci-lint find no Go files at all and exit
        # with "no go files to analyze", which the hook then reports as lint
        # issues — blocking every commit to those suites while saying nothing
        # about the code. Keep in sync with the //go:build tags in tests/.
        lint_tags="chiptool,integration,integration_live,e2e,bench,loadtest,cuxd_live,cuxd_live_push,deadlock,race"
        # shellcheck disable=SC2086
        if ! "$GOLANGCI_BIN" run --new-from-rev=HEAD --timeout=300s \
            --build-tags="$lint_tags" "${lint_pkgs[@]}" 2>&1 | sed 's/^/    /' >&2; then
            fail "golangci-lint reported issues; fix before committing"
            note "to skip once: GOHM_PRECOMMIT_SKIP_LINT=1 git commit ..."
            exit 1
        fi
        ok "lint clean (incremental scope)"
    fi
fi

# ---------------------------------------------------------------------------
# Stage 5 — fast unit + contract tests on the packages touched by the
# staged change. Falls back to the full contract suite when no Go files
# are staged (covers doc-only commits that still benefit from a green
# baseline). Skippable via GOHM_PRECOMMIT_SKIP_TESTS=1.
# ---------------------------------------------------------------------------
if [[ "${GOHM_PRECOMMIT_SKIP_TESTS:-0}" == "1" ]]; then
    warn "tests skipped via GOHM_PRECOMMIT_SKIP_TESTS=1"
else
    if [[ $NO_GO -eq 0 ]]; then
        # Map each staged .go file to its directory, deduplicate, and
        # rewrite as Go-package paths (./internal/foo/bar). Skip files
        # outside the module root (defensive — git diff is already
        # repo-relative, but the user might run with subtree config).
        declare -A pkg_set=()
        for f in "${STAGED_GO[@]}"; do
            d="$(dirname -- "$f")"
            pkg_set["./$d/..."]=1
        done
        mapfile -t pkgs < <(printf '%s\n' "${!pkg_set[@]}" | sort)
        # Always include the contract suite — DocPurity, OpenAPI,
        # backend-capabilities and the new audit guards live there
        # and are cheap to run.
        pkgs+=("./tests/contract/...")
        step "go test ${#pkgs[@]} package set(s) (count=1, timeout=180s)"
        # shellcheck disable=SC2086
        if ! go test -count=1 -timeout=180s "${pkgs[@]}" 2>&1 | tail -40 | sed 's/^/    /' >&2; then
            fail "tests failed"
            note "to skip once: GOHM_PRECOMMIT_SKIP_TESTS=1 git commit ..."
            exit 1
        fi
        ok "tests green"
    else
        step "go test ./tests/contract/... (no Go files staged → contract baseline only)"
        if ! go test -count=1 -timeout=120s ./tests/contract/... 2>&1 | tail -20 | sed 's/^/    /' >&2; then
            fail "contract tests failed"
            exit 1
        fi
        ok "contract baseline green"
    fi
fi

ok "pre-commit: all checks passed"
exit 0
